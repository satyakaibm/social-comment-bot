# Maximum amount of work performed by one polling cycle.
# Keep every value as a positive integer.
POLLING_LOG_FILE=data/polling.log

# Ignore comments older than this many days across every platform.
COMMENT_MAX_AGE_DAYS=90

# Every video in the scan costs one commentThreads.list unit per cycle, so
# the three YouTube values below are one quota budget, not three knobs.
# Measured 2026-10-07 on Hindolroad: a cycle cost ~130 units at 75 newest
# uploads + every video with a comment in 90 days (~95 videos), plus 50
# units per reply posted (~40/day). At 30-minute polling that was ~8.2k of
# the 10k daily quota; just halving the interval would have run out of
# quota around 20:00 PT every day. Dashboard data showed 19 videos with a
# comment in the last 14 days, 26 in 21, 35 in 30 -- almost all of them
# already inside the newest-50 window -- so the scan is cut to ~60 videos
# (~65 units/cycle) and the interval halved: 96 cycles x 65 + replies is
# the same ~8.2k/day as before, with replies now landing within 15 minutes
# of the comment instead of 30.
YOUTUBE_VIDEO_LIMIT=50
# A video still getting comments this recently is kept in the scan even
# after it's aged out of the latest-uploads window above. Shorter than
# COMMENT_MAX_AGE_DAYS on purpose: a video quiet for three weeks is checked
# again only once it re-enters the newest-uploads window or someone adds it
# to YOUTUBE_VIDEO_IDS, which is the quota price of the faster cadence.
YOUTUBE_ACTIVE_VIDEO_DAYS=21
YOUTUBE_COMMENT_LIMIT=5000
YOUTUBE_PUBLISH_LIMIT=100
# The dedicated youtube-comments container runs once at startup and then at
# this interval. 900 seconds (15 min): a reply now arrives a median ~9
# minutes after the comment (was ~18, max 30). The Status page's YouTube
# quota card is the thing to watch after changing any of these; if it
# trends past ~9k by the evening PT, raise this back toward 1200.
YOUTUBE_POLL_INTERVAL_SECONDS=900
PUBLISH_ERROR_LIMIT=3

FACEBOOK_POST_LIMIT=25
FACEBOOK_COMMENT_LIMIT=50
FACEBOOK_PUBLISH_LIMIT=25

INSTAGRAM_MEDIA_LIMIT=25
INSTAGRAM_COMMENT_LIMIT=50
INSTAGRAM_PUBLISH_LIMIT=50

# Optional: cap total replies posted per platform per IST calendar day,
# counted across every cron cycle (unlike the *_PUBLISH_LIMIT values above,
# which only cap a single cycle). Leave unset, or 0, for no daily cap.
#YOUTUBE_DAILY_REPLY_LIMIT=200
#FACEBOOK_DAILY_REPLY_LIMIT=200
#INSTAGRAM_DAILY_REPLY_LIMIT=200

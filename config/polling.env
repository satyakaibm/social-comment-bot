# Maximum amount of work performed by one polling cycle.
# Keep every value as a positive integer.
POLLING_LOG_FILE=data/polling.log

# Ignore comments older than this many days across every platform.
COMMENT_MAX_AGE_DAYS=180

YOUTUBE_VIDEO_LIMIT=25
YOUTUBE_COMMENT_LIMIT=50
YOUTUBE_PUBLISH_LIMIT=50
PUBLISH_ERROR_LIMIT=3

FACEBOOK_POST_LIMIT=25
FACEBOOK_COMMENT_LIMIT=50
FACEBOOK_PUBLISH_LIMIT=25

INSTAGRAM_MEDIA_LIMIT=25
INSTAGRAM_COMMENT_LIMIT=50
INSTAGRAM_PUBLISH_LIMIT=50

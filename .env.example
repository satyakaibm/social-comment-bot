GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
REPLY_PERSONA=

YOUTUBE_OAUTH_CLIENT_ID=
YOUTUBE_OAUTH_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_VIDEO_IDS=

META_GRAPH_VERSION=v26.0
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
INSTAGRAM_USER_ID=

# Required for signed Facebook and Instagram webhook delivery.
META_APP_SECRET=
# Generate a private random value and enter it in both .env and Meta's dashboard.
META_WEBHOOK_VERIFY_TOKEN=
META_WEBHOOK_AUTO_POST=true
META_WEBHOOK_ENABLED=false
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=9001
DASHBOARD_SECRET=change-this-local-secret
DASHBOARD_USERNAME=admin
# Generate with: python scripts/generate_dashboard_password.py
DASHBOARD_PASSWORD_HASH_B64=
DASHBOARD_SESSION_HOURS=12
# Set true when the browser reaches the dashboard over HTTPS.
DASHBOARD_COOKIE_SECURE=false

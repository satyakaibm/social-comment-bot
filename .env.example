GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
REPLY_PERSONA=

# Comments older than this are not drafted, liked, or replied to.
COMMENT_MAX_AGE_DAYS=90

YOUTUBE_OAUTH_CLIENT_ID=
YOUTUBE_OAUTH_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
# Optional priority videos. Latest uploads are always scanned as well.
YOUTUBE_VIDEO_IDS=

META_GRAPH_VERSION=v26.0
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
# Facebook is optimized for speed: it does not look through an entire reply
# thread before posting. Turn this on only if you prefer the slower duplicate
# check after a timeout or a manual Page reply.
FACEBOOK_VERIFY_EXISTING_REPLIES=false
# Fast, retryable Graph reads use these values. Writes retain a longer timeout
# because a reply may reach Meta even when its response is delayed.
META_CONNECT_TIMEOUT_SECONDS=5
META_READ_TIMEOUT_SECONDS=15
META_WRITE_TIMEOUT_SECONDS=30
META_GET_RETRIES=2
# Retry Meta's temporary Graph API error code 1 once, after two seconds.
META_POST_RETRIES=2
META_POST_RETRY_DELAY_SECONDS=2
# Some comments (hidden by Meta, commenter blocked the Page, comment deleted,
# ...) fail with the same error on every attempt. Stop auto-retrying a
# comment after this many failed attempts across all cycles.
META_MAX_POST_ATTEMPTS=5
# Reuse a completed fresh Instagram reply check for this many seconds.
META_RECENT_REPLY_CHECK_SECONDS=300

# Required for signed Facebook and Instagram webhook delivery.
META_APP_SECRET=
# Generate a private random value and enter it in both .env and Meta's dashboard.
META_WEBHOOK_VERIFY_TOKEN=
META_WEBHOOK_AUTO_POST=true
META_WEBHOOK_ENABLED=false
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=9001
DASHBOARD_SECRET=change-this-local-secret
DASHBOARD_USERNAME=admin
# Generate with: python scripts/generate_dashboard_password.py
DASHBOARD_PASSWORD_HASH_B64=
DASHBOARD_SESSION_HOURS=12
# Set true when the browser reaches the dashboard over HTTPS.
DASHBOARD_COOKIE_SECURE=false

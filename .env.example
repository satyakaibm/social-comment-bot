GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
REPLY_PERSONA=

YOUTUBE_OAUTH_CLIENT_ID=
YOUTUBE_OAUTH_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_VIDEO_IDS=

META_GRAPH_VERSION=v26.0
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
INSTAGRAM_USER_ID=

# Required for signed Facebook and Instagram webhooks.
META_APP_SECRET=
# Choose a private random value and enter the same value in Meta's webhook setup.
META_WEBHOOK_VERIFY_TOKEN=
META_WEBHOOK_AUTO_POST=true
WEBHOOK_HOST=127.0.0.1
WEBHOOK_PORT=8080
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=9001

# Set true only if cron should scan Meta as a fallback while webhooks are unavailable.
META_POLL_FALLBACK=false
